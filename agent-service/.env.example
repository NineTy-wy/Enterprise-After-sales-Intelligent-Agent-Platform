APP_NAME=after-sales-agent-service
HOST=0.0.0.0
PORT=8000
LLM_PROVIDER=mock
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=128
VECTOR_STORE=memory
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=after_sales_chunks
STORAGE_ROOT=./data/files
STORAGE_MODE=local
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=agent-platform
REDIS_URL=redis://localhost:6379/0
BACKEND_SERVICE_URL=http://localhost:8080
AGENT_SERVICE_TOKEN=
TOP_K=8
RERANK_TOP_K=4
MAX_CONTEXT_TOKENS=3500
CACHE_TTL_SECONDS=30
SENSITIVE_TERMS=身份证,银行卡,密码,secret,api_key
EVALUATION_FILE=./data/evaluations.jsonl
